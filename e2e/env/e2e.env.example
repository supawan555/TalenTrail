# TalenTrail E2E backend environment.
#
# run.ps1 copies this to BackEnd/.env for the duration of a run (backing up any
# existing BackEnd/.env first). pydantic-settings loads BackEnd/.env with higher
# precedence than the repo-root .env, so this never disturbs your real config.
#
# Copy to e2e/env/e2e.env and adjust if needed.

# Throwaway Mongo. run.ps1 starts a disposable Docker container on port 27057
# (NOT the default 27017 - on a machine with a native "MongoDB Server" service
# already listening there, Docker's port-forward silently loses that bind race,
# so anything pointed at 27017 ends up hitting your real local Mongo instead of
# the disposable container) and overrides this value with $env:MONGO_DB_URI, so
# it only matters if you run the backend against this file without run.ps1.
MONGO_DB_URI=mongodb://localhost:27057

# Isolated logical DB names so the suite never touches shared/Atlas data.
PRIMARY_DB=talentrail_e2e
HR_DB=talentrail_e2e_hr

# Fixed so JWT cookies + encrypted TOTP secrets survive a backend restart.
SECRET_KEY_AUTHEN=e2e-fixed-secret-not-for-production
TOTP_ENCRYPTION_KEY=e2e-fixed-totp-key-not-for-production

# SMTP intentionally unset: forgot-password OTP is logged, not emailed.

# NOTE: TALENTRAIL_ALLOW_DEGRADED_LLM and TALENTTAIL_TOTP_STATIC_SECRET are
# deliberately NOT here. BackEnd/app/config.py's pydantic Settings model
# forbids unknown keys in .env (extra_forbidden) and doesn't declare these two
# - they're read via plain os.getenv() elsewhere (app/ml/health.py,
# app/routers/auth.py), so they must be real process environment variables.
# run.ps1 sets them with $env: before starting uvicorn/the seed scripts.
