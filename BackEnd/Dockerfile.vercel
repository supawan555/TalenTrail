# Container image for deploying the FastAPI backend on Vercel.
# (The plain Dockerfile is kept for Render.)
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    HF_HOME=/models

WORKDIR /code

# torch (CPU build, via the extra index in requirements.txt) is required at
# runtime: it is the engine that runs the SBERT model.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake the SBERT model into the image. Without this, every cold start would
# download ~90 MB from HuggingFace before the first resume could be scored.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# The model is now in /models; never reach out to HuggingFace at runtime.
ENV HF_HUB_OFFLINE=1

# job_preload reads this file from the directory above app/.
COPY mock_job_descriptions.json .
COPY ./app ./app

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
